# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID from the R2 dashboard (not the global account ID)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token credentials — must be exactly 32 characters
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket name (default used in code: nyc-collisions)
R2_BUCKET_NAME=nyc-collisions

# ── Inference API ─────────────────────────────────────────────────────────────
# Local dev: http://localhost:8000
# Railway production: http://<service-name>.railway.internal:<port>
INFERENCE_API_URL=http://localhost:8000

# Shared secret for X-API-Key header — generate with: openssl rand -hex 32
API_KEY=your-api-key

# ── Streamlit / Railway Volume ─────────────────────────────────────────────────
# Local dev: ./data
# Railway production: /data (set automatically via Railway Volume mount)
RAILWAY_VOLUME_MOUNT_PATH=./data

# How long (seconds) to serve cached parquet before checking R2 for new data
# Default: 6 days (slightly under the weekly pipeline schedule)
# PARQUET_CACHE_TTL=518400

# ── NYC Open Data ─────────────────────────────────────────────────────────────
# Optional but recommended — raises Socrata API rate limits
# Register at: https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=your-socrata-app-token

# ── Airflow worker (docker-compose.yaml environment block) ────────────────────
# These must be OS-level env vars on the worker, not just Airflow Variables,
# so the PythonOperator tasks can read them via os.environ.
#
# GITHUB_TOKEN=your-github-pat-with-workflow-scope
# GITHUB_REPO=RasheedMartin/Nyc-Vehicle-Collisions
# GITHUB_REF=main
