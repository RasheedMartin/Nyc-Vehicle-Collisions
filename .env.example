# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID from the R2 dashboard (not the global account ID)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token credentials — must be exactly 32 characters
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket name (default used in code: nyc-collisions)
R2_BUCKET_NAME=nyc-collisions

# ── Inference API ─────────────────────────────────────────────────────────────
# Local dev: http://localhost:8000
# Railway production: http://<service-name>.railway.internal:<port>
INFERENCE_API_URL=http://localhost:8000

# Shared secret for X-API-Key header — generate with: openssl rand -hex 32
API_KEY=your-api-key

# ── Streamlit / Railway Volume ─────────────────────────────────────────────────
# Local dev: ./data
# Railway production: /data (set automatically via Railway Volume mount)
RAILWAY_VOLUME_MOUNT_PATH=./data

# How long (seconds) to serve cached parquet before checking R2 for new data
# Default: 1 hour (the check is a single HEAD request against R2)
# PARQUET_CACHE_TTL=3600

# ── NYC Open Data ─────────────────────────────────────────────────────────────
# Optional but recommended — raises Socrata API rate limits
# Register at: https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=your-socrata-app-token

# ── Airflow worker (docker-compose.yaml environment block) ────────────────────
# These must be OS-level env vars on the worker, not just Airflow Variables,
# so the PythonOperator tasks can read them via os.environ.
#
GITHUB_TOKEN=
GITHUB_REPO=RasheedMartin/Nyc-Vehicle-Collisions
GITHUB_REF=main

# ── Airflow (airflow/docker-compose.yaml locally, Railway "Airflow" service) ──
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate: openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=you@example.com

# Railway: set to ${{Postgres.DATABASE_URL}} (entrypoint maps DATABASE_URL automatically)
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=

# HttpSensor connection for wait_for_api — on Railway use the private domain:
#   http://unique-harmony.railway.internal:8080
AIRFLOW_CONN_INFERENCE_API=http://host.docker.internal:8000

# Success/failure notifications (Gmail: use an App Password, not your real password)
NOTIFY_EMAIL=
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=
